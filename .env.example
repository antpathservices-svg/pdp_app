# Copiar a .env (en la raiz; .env esta en .gitignore). Sin secretos: la autenticacion
# a SharePoint es interactiva (Connect-PnPOnline -Interactive), no hay contrasena aqui.

# Sitio de SharePoint y registro de aplicacion de Entra ID (no son secretos)
SITE_URL=https://franquiciasab.sharepoint.com/sites/DEPRITAM
CLIENT_ID=4deb1dff-7bca-4091-b539-43e8a1a3b572

# Zona horaria en que el POS guarda las horas (se convierten a UTC)
TZ_POS=America/Matamoros

# Volcado de texto fuente (solo referencia; lo lee parser_volcado.py)
RUTA_VOLCADO=data/raw/resultado contrato bronze.txt
# Carpeta con los Parquet del volcado (entrada de transformar.py)
RUTA_RAW=data/raw/pos_volcado_2026-10-28
# Salida de transformar.py (jsonl) y bitacora estado.json
RUTA_CARGA=data/carga

# Lotes de Add-PnPListItem -Batch (100 a 200) y pausa entre lotes en segundos
TAMANO_LOTE=100
PAUSA_ENTRE_LOTES=1
